# ЭНЭКА.Командировки. Скопировать в .env.local и заполнить.

# --- Публичный адрес приложения ---------------------------------------------
# Единственное место, где задаётся домен. Он же попадает в App ID URI,
# в messaging endpoint бота и в манифест Teams. При переезде на корпоративный
# поддомен меняется только здесь (и в трёх местах в Entra/Azure/Teams).
# Production-адрес Vercel, без схемы и в нижнем регистре. Адреса preview-деплоев
# не подходят: они меняются, и вход через Entra на них не работает.
NEXT_PUBLIC_APP_DOMAIN=eneca-trips.vercel.app

# --- Entra ID (регистрация приложения) --------------------------------------
ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Teams-бот (Azure Bot Service) ------------------------------------------
# Та же регистрация приложения, что и для вкладки.
MICROSOFT_APP_TYPE=SingleTenant
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram-бот водителей -------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Произвольная строка: Telegram возвращает её в заголовке вебхука.
TELEGRAM_WEBHOOK_SECRET=
