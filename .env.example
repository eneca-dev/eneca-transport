# ЭНЭКА.Командировки. Скопировать в .env.local и заполнить.

# --- Публичный адрес приложения ---------------------------------------------
# Единственное место, где задаётся домен. Он же попадает в App ID URI,
# в messaging endpoint бота и в манифест Teams. При переезде на корпоративный
# поддомен меняется только здесь (и в трёх местах в Entra/Azure/Teams).
# Production-адрес Vercel, без схемы и в нижнем регистре. Адреса preview-деплоев
# не подходят: они меняются, и вход через Entra на них не работает.
NEXT_PUBLIC_APP_DOMAIN=eneca-trips.vercel.app

# --- Entra ID (регистрация приложения) --------------------------------------
ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Teams-бот --------------------------------------------------------------
# Бот заведён в Teams Developer Portal (dev.teams.microsoft.com → Tools → Bot
# management), у него ОТДЕЛЬНАЯ регистрация приложения — не та, что у вкладки.
# Ресурс Azure Bot и подписка Azure при этом не нужны.
#
# MICROSOFT_APP_TYPE: только SingleTenant. Портал показывает бота как
# MultiTenant, и это сбивает с толку, но Bot Connector принимает лишь токен,
# выданный тенантом ЭНЭКА. Проверено 16.11: токен от botframework.com — 401
# «Authorization has been denied», от тенанта — 201. При MultiTenant бот
# принимает входящие, но не может ни ответить, ни отправить уведомление.
MICROSOFT_APP_TYPE=SingleTenant
# Со страницы бота в Developer Portal (он же botId в манифесте Teams).
MICROSOFT_APP_ID=
# Developer Portal → бот → Client secrets. Значение показывается один раз.
# Это НЕ секрет вкладки: регистрации разные.
MICROSOFT_APP_PASSWORD=
# Обязателен при SingleTenant: по нему botbuilder строит адрес центра выдачи
# токена. Тот же GUID, что и ENTRA_TENANT_ID. Пустое значение вернёт 401.
MICROSOFT_APP_TENANT_ID=

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Применение миграций (необязательно) ------------------------------------
# Personal access token Supabase: Account -> Access Tokens. Нужен только для
# scripts/apply-migration.mjs, приложению не требуется. Даёт доступ ко ВСЕМ
# проектам аккаунта, поэтому после применения миграций его стоит отозвать.
SUPABASE_ACCESS_TOKEN=
# --- Telegram-бот водителей -------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Произвольная строка: Telegram возвращает её в заголовке вебхука.
TELEGRAM_WEBHOOK_SECRET=

# --- Задачи по расписанию ---------------------------------------------------
# Секрет задач. Vercel Cron сам передаёт его в заголовке Authorization, если
# переменная задана; без неё адрес задачи может дёрнуть кто угодно. Имя
# CRON_SECRET выбрано не нами — его ищет сам Vercel.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
